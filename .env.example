# Override any of these via environment or a local .env file.
# All variables are prefixed with WP_.

WP_DATA_DIR=./data
WP_DATABASE_URL=sqlite:///./data/properties.db

WP_MAX_PROPERTIES_PER_COMBINATION=500
WP_DELAY_SECONDS_BETWEEN_COMBINATIONS=10
WP_HTTP_MAX_ATTEMPTS=4
WP_HTTP_MAX_CONCURRENT=5
WP_HTTP_TIMEOUT_SECONDS=30.0

WP_LOG_LEVEL=INFO
